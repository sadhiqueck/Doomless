{
  "manifest_version": 3,
  "name": "Doomless",
  "version": "1.0.0",
  "description": "Block the doomscroll. Swap in your sprint backlog.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.instagram.com/*",
    "https://www.tiktok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "content/shared/storage.js",
        "content/shared/hide-feed.js",
        "content/shared/card-deck.js",
        "content/shared/card-ui.js",
        "content/youtube.js"
      ],
      "css": ["content/youtube.css", "content/shared/card.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": [
        "content/shared/storage.js",
        "content/shared/hide-feed.js",
        "content/shared/card-deck.js",
        "content/shared/card-ui.js",
        "content/instagram.js"
      ],
      "css": ["content/instagram.css", "content/shared/card.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": [
        "content/shared/storage.js",
        "content/shared/hide-feed.js",
        "content/shared/card-deck.js",
        "content/shared/card-ui.js",
        "content/tiktok.js"
      ],
      "css": ["content/tiktok.css", "content/shared/card.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "commands": {
    "toggle-focus": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Toggle focus mode on or off"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/shared/card.css",
        "assets/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
