{
  "manifest_version": 3,
  "name": "Focus Extension",
  "version": "0.2.0",
  "description": "Block the scroll. Swap in your work.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.instagram.com/*",
    "https://www.tiktok.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/shared/storage.js", "content/shared/hide-feed.js", "content/youtube.js"],
      "css": ["content/youtube.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content/shared/storage.js", "content/shared/hide-feed.js", "content/instagram.js"],
      "css": ["content/instagram.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["content/shared/storage.js", "content/shared/hide-feed.js", "content/tiktok.js"],
      "css": ["content/tiktok.css"],
      "run_at": "document_start"
    }
  ]
}
